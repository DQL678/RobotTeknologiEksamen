#include <Servo.h>
#include <LiquidCrystal.h>

// ---------------- LCD ----------------
LiquidCrystal lcd(13, 12, 11, 10, 9, 8);

// ---------------- ULTRALYD ----------------
const int trigPin = 52;
const int echoPin = 53;

// ---------------- LEDS ----------------
const int redLED = 23;
const int greenLED = 22;

// ---------------- BUTTON ----------------
const int btnToggle = 24;

long duration;
Servo myServo;

// ---------------- SERVO ----------------
int servoPos = 90;
int direction = 1;
int lastBtnState = 0;

// ---------------- FILTER ----------------
const int FILTER_SIZE = 7;
int filterBuffer[FILTER_SIZE];
int filterIndex = 0;
bool bufferFilled = false;

// ================= SETUP =================
void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(btnToggle, INPUT);

  Serial.begin(9600);
  myServo.attach(50);

  lcd.begin(16, 2);

  for (int i = 0; i < FILTER_SIZE; i++) {
    filterBuffer[i] = 0;
  }
}

// ================= LOOP =================
void loop() {

  // -------- BUTTON --------
  int btnState = digitalRead(btnToggle);
  if (btnState == HIGH && lastBtnState == LOW) {
    direction = -direction;
  }
  lastBtnState = btnState;

  // -------- SERVO (0–180) --------
  servoPos += direction;

  if (servoPos >= 180) direction = -1;
  if (servoPos <= 0) direction = 1;

  myServo.write(servoPos);

  // -------- DISTANCE --------
  int filtered = calculateFilteredDistance();

  // -------- LEDS --------
  updateLEDs(filtered);

  // -------- LCD --------
  lcd.setCursor(0, 0);
  lcd.print("                ");
  lcd.setCursor(0, 0);

  if (filtered > 0 && filtered <= 100) {
    lcd.print("Object detected");

    lcd.setCursor(0, 1);
    lcd.print("Dist: ");
    lcd.print(filtered);
    lcd.print(" cm   ");
  } else {
    lcd.print("Area is empty");

    lcd.setCursor(0, 1);
    lcd.print("No object       ");
  }

  // -------- SERIAL (PYTHON FORMAT) --------
  Serial.print(servoPos);
  Serial.print(",");
  Serial.print(filtered);
  Serial.println(".");

  delay(15);
}

// ================= ULTRALYD =================
int calculateDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) return 0;

  int d = duration * 0.034 / 2;

  if (d < 2 || d > 100) return 0;

  return d;
}

// ================= FILTER (FIXED) =================
int calculateFilteredDistance() {
  int raw = calculateDistance();

  bool hasValid = false;

  if (raw > 0) {
    filterBuffer[filterIndex] = raw;
    filterIndex++;

    if (filterIndex >= FILTER_SIZE) {
      filterIndex = 0;
      bufferFilled = true;
    }

    hasValid = true;
  }

  long sum = 0;
  int count = bufferFilled ? FILTER_SIZE : filterIndex;

  if (count == 0 || !hasValid) return 0;

  for (int i = 0; i < count; i++) {
    sum += filterBuffer[i];
  }

  return sum / count;
}

// ================= LEDS =================
void updateLEDs(int dist) {
  if (dist > 0 && dist <= 100) {
    digitalWrite(redLED, HIGH);   // object detected
    digitalWrite(greenLED, LOW);
  } else {
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
  }
}