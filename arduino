#include <Servo.h>
#include <LiquidCrystal.h>

// ---------------- LCD ----------------
LiquidCrystal lcd(13, 12, 11, 10, 9, 8);

// ---------------- ULTRALYD ----------------
const int trigPin = 52;
const int echoPin = 53;

// ---------------- LEDS ----------------
const int redLED = 23;
const int greenLED = 22;

// ---------------- BUTTON ----------------
const int btnToggle = 24;

long duration;
Servo myServo;

// ---------------- SERVO ----------------
int servoPos = 90;
int direction = 1;
int lastBtnState = 0;

// ---------------- FILTER ----------------
const int FILTER_SIZE = 7;
int filterBuffer[FILTER_SIZE];
int filterIndex = 0;
bool bufferFilled = false;

// ---------------- STATE ----------------
bool objectDetected = false;
unsigned long lastSeenTime = 0;

int lastStableDistance = 0;


// ================= SETUP =================
void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);

  pinMode(btnToggle, INPUT);

  Serial.begin(9600);
  myServo.attach(50);

  lcd.begin(16, 2);

  for (int i = 0; i < FILTER_SIZE; i++) {
    filterBuffer[i] = 0;
  }
}


// ================= LOOP =================
void loop() {

  // -------- BUTTON --------
  int btnState = digitalRead(btnToggle);
  if (btnState == HIGH && lastBtnState == LOW) {
    direction = -direction;
  }
  lastBtnState = btnState;

  // -------- SERVO --------
  servoPos += direction;

  if (servoPos >= 165) direction = -1;
  if (servoPos <= 15) direction = 1;

  myServo.write(servoPos);

  // -------- DISTANCE --------
  int filtered = calculateFilteredDistance();

  // -------- DETECTION STATE --------
  if (filtered > 0 && filtered <= 100) {
    objectDetected = true;
    lastSeenTime = millis();
    lastStableDistance = filtered;
  }

  if (millis() - lastSeenTime > 300) {
    objectDetected = false;
  }

  // -------- LED (MATCHER LCD) --------
  updateLEDs();

  // -------- LCD --------
  lcd.setCursor(0, 0);
  lcd.print("                ");
  lcd.setCursor(0, 1);
  lcd.print("                ");

  if (objectDetected) {
    lcd.setCursor(0, 0);
    lcd.print("Object detected");

    lcd.setCursor(0, 1);
    lcd.print("Dist:");
    lcd.print(lastStableDistance);
    lcd.print(" cm");
  } else {
    lcd.setCursor(0, 0);
    lcd.print("Area is empty");

    lcd.setCursor(0, 1);
    lcd.print("No object");
  }

  // -------- SERIAL (PYTHON) --------
  Serial.print(servoPos);
  Serial.print(",");
  Serial.println(filtered);

  delay(15);
}


// ================= DISTANCE =================
int calculateDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) return -1;

  int d = duration * 0.034 / 2;

  if (d < 2 || d > 100) return -1;

  return d;
}


// ================= FILTER =================
int calculateFilteredDistance() {
  int raw = calculateDistance();

  if (raw != -1) {
    filterBuffer[filterIndex] = raw;
    filterIndex++;

    if (filterIndex >= FILTER_SIZE) {
      filterIndex = 0;
      bufferFilled = true;
    }
  }

  long sum = 0;
  int count = bufferFilled ? FILTER_SIZE : filterIndex;

  if (count == 0) return 0;

  for (int i = 0; i < count; i++) {
    sum += filterBuffer[i];
  }

  return sum / count;
}


// ================= LED =================
void updateLEDs() {
  if (objectDetected) {
    if (lastStableDistance < 40) {
      digitalWrite(redLED, HIGH);
      digitalWrite(greenLED, LOW);
    } else {
      digitalWrite(redLED, LOW);
      digitalWrite(greenLED, HIGH);
    }
  } else {
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
  }
}