#include <Servo.h>              // Bibliotek til servostyring
#include <LiquidCrystal.h>      // Bibliotek til LCD-display

// ---------------- LCD ----------------
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);   // LCD tilsluttet de angivne pins

// ---------------- ULTRALYD ----------------
const int trigPin = 52;         // Sender ultralydspulsen
const int echoPin = 40;         // Modtager ekkoet

// ---------------- LEDS ----------------
const int redLED = 26;          // Rød LED: objekt fundet
const int greenLED = 22;        // Grøn LED: ingen objekt

// ---------------- BUTTON ----------------
const int btnToggle = 24;       // Knap til at skifte servoens retning

long duration;                  // Bruges til at måle ekkotid
Servo myServo;                  // Servo-objekt

// ---------------- SERVO ----------------
int servoPos = 90;              // Starter i midten
int direction = 1;              // 1 = frem, -1 = tilbage
int lastBtnState = 0;           // Til at registrere knaptryk

// Hastighedsstyring af servo
unsigned long lastMoveTime = 0;
const int moveInterval = 40;    // Jo større tal, jo langsommere bevægelse

// ---------------- FILTER ----------------
const int FILTER_SIZE = 7;      // Antal målinger i gennemsnittet
int filterBuffer[FILTER_SIZE];  // Buffer til filtrerede værdier
int filterIndex = 0;
bool bufferFilled = false;

// ---------------- LCD CONTROL ----------------
int lastShownDistance = -1;     // Sidst viste afstand
bool lastDetectedState = false; // Sidste detektionsstatus

unsigned long lastLCDUpdate = 0;
const int lcdInterval = 400;    // LCD opdateres max hver 400 ms


// ================= SETUP =================
void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(btnToggle, INPUT);

  Serial.begin(9600);
  myServo.attach(50);           // Servo tilsluttes pin 50

  lcd.begin(16, 2);             // Starter LCD-displayet
  lcd.clear();

  for (int i = 0; i < FILTER_SIZE; i++) {
    filterBuffer[i] = 0;        // Buffer nulstilles
  }
}


// ================= LOOP =================
void loop() {

  // -------- BUTTON --------
  int btnState = digitalRead(btnToggle);          // Læser knappen
  if (btnState == HIGH && lastBtnState == LOW) {  // Registrerer et enkelt tryk
    direction = -direction;                       // Skifter servoens retning
  }
  lastBtnState = btnState;

  // -------- SERVO --------
  if (millis() - lastMoveTime >= moveInterval) {  // Styrer servoens hastighed
    lastMoveTime = millis();

    servoPos += direction;                        // Flytter servoen 1 grad

    if (servoPos >= 180) direction = -1;          // Vend ved 180°
    if (servoPos <= 0)   direction = 1;           // Vend ved 0°

    myServo.write(servoPos);                      // Opdaterer servoens position
  }

  // -------- DISTANCE --------
  int filtered = calculateFilteredDistance();     // Filtreret afstand
  bool detected = (filtered > 0 && filtered <= 100); // Objekt inden for rækkevidde?

  // -------- LEDS --------
  updateLEDs(filtered);                           // Skifter LED efter afstand

  // -------- LCD --------
  if (millis() - lastLCDUpdate > lcdInterval) {   // Opdaterer LCD med passende mellemrum,
                                                  // så teksten ikke virker urolig at se på

    // Kun opdatering hvis der er ændring
    if (detected != lastDetectedState || abs(filtered - lastShownDistance) > 2) {

      lcd.clear();

      if (detected) {
        lcd.setCursor(0, 0);
        lcd.print("Object detected");

        lcd.setCursor(0, 1);
        lcd.print("Dist: ");
        lcd.print(filtered);
        lcd.print(" cm");
      } else {
        lcd.setCursor(0, 0);
        lcd.print("Area is empty");

        lcd.setCursor(0, 1);
        lcd.print("No object");
      }

      lastShownDistance = filtered;
      lastDetectedState = detected;
    }

    lastLCDUpdate = millis();
  }

  // -------- SERIAL (PYTHON) --------
  Serial.print(servoPos);       // Sender servoens position
  Serial.print(",");
  Serial.print(filtered);       // Sender afstand til Python
  Serial.println(".");

  delay(50);                    // Lille pause for stabilitet
}


// ================= ULTRALYD =================
int calculateDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);  // Sender 10 µs puls
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH, 30000); // Måler ekkotid

  if (duration == 0) return 0;  // Ingen måling

  int d = duration * 0.034 / 2; // Omregning til cm

  if (d < 2 || d > 100) return 0; // Filtrerer ugyldige værdier

  return d;
}


// ================= FILTER =================
int calculateFilteredDistance() {
  int raw = calculateDistance(); // Rå måling

  bool hasValid = false;

  if (raw > 0) {
    filterBuffer[filterIndex] = raw;  // Lægger måling i buffer
    filterIndex++;

    if (filterIndex >= FILTER_SIZE) { // Loop buffer
      filterIndex = 0;
      bufferFilled = true;
    }

    hasValid = true;
  }

  long sum = 0;
  int count = bufferFilled ? FILTER_SIZE : filterIndex;

  if (count == 0 || !hasValid) return 0; // Ingen gyldige målinger endnu

  for (int i = 0; i < count; i++) {
    sum += filterBuffer[i];             // Summerer målinger
  }

  return sum / count;                   // Gennemsnit
}


// ================= LEDS =================
void updateLEDs(int dist) {
  if (dist > 5 && dist <= 100) {        // Objekt fundet
    digitalWrite(redLED, HIGH);
    digitalWrite(greenLED, LOW);
  } else {                              // Ingen objekt
    digitalWrite(redLED, LOW);
    digitalWrite(greenLED, HIGH);
  }
}
